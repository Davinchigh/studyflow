# Hosted (free): a Postgres connection string, e.g. Neon's pooled URL. Each workspace becomes a schema.
# Leave unset to use SQLite files instead (local development, or a host with a persistent disk).
DATABASE_URL=
# SQLite only: where workspace databases live. Must be on persistent storage in production.
STUDY_DATA_DIR=/data
# The exact address of the deployed frontend, comma-separated if more than one. No trailing slash.
ALLOWED_ORIGINS=https://your-studyflow-site.example
# Safety limits for a public test.
MAX_WORKSPACES=1000
RATE_LIMIT_PER_MINUTE=240
